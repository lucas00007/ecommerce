{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda function for Stripe payments",
  "Parameters": {
    "CloudWatchRule": {
      "Type": "String",
      "Default": "NONE"
    },
    "deploymentBucketName": {
      "Type": "String"
    },
    "env": {
      "Type": "String"
    },
    "s3Key": {
      "Type": "String"
    },
    "stripeSecretKey": {
      "Type": "String",
      "Default": "NONE"
    }
  },
  "Conditions": {
    "ShouldNotCreateEnvResources": {
      "Fn::Equals": [{"Ref": "env"}, "NONE"]
    }
  },
  "Resources": {
    "LambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": {"Ref": "deploymentBucketName"},
          "S3Key": {"Ref": "s3Key"}
        },
        "Handler": "index.handler",
        "FunctionName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "stripePayment",
            {"Fn::Join": ["", ["stripePayment", "-", {"Ref": "env"}]]}
          ]
        },
        "Environment": {
          "Variables": {
            "ENV": {"Ref": "env"},
            "REGION": {"Ref": "AWS::Region"},
            "STRIPE_SECRET_KEY": {"Ref": "stripeSecretKey"}
          }
        },
        "Role": {"Fn::GetAtt": ["LambdaExecutionRole", "Arn"]},
        "Runtime": "nodejs18.x",
        "Timeout": 25
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": {"Service": ["lambda.amazonaws.com"]},
            "Action": ["sts:AssumeRole"]
          }]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ]
      }
    },
    "LambdaFunctionUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {"Fn::GetAtt": ["LambdaFunction", "Arn"]},
        "Cors": {
          "AllowOrigins": ["*"],
          "AllowMethods": ["POST", "OPTIONS"],
          "AllowHeaders": ["Content-Type"]
        }
      }
    },
    "LambdaFunctionUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {"Ref": "LambdaFunction"},
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    }
  },
  "Outputs": {
    "Name": {"Value": {"Ref": "LambdaFunction"}},
    "Arn": {"Value": {"Fn::GetAtt": ["LambdaFunction", "Arn"]}},
    "Region": {"Value": {"Ref": "AWS::Region"}},
    "FunctionUrl": {"Value": {"Fn::GetAtt": ["LambdaFunctionUrl", "FunctionUrl"]}}
  }
}
